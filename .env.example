# Copy to .env and fill in. Never commit .env.

# "offline" = no API calls, free (tests, CI, and SQL typed by hand)
# "azure"   = Azure OpenAI (uses your student credit)
LLM_PROVIDER=offline

# From the portal: your resource's endpoint (https://<name>.openai.azure.com/) and KEY 1
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The deployment name you typed when deploying, and the model behind it
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_CHAT_MODEL=gpt-5-mini
# minimal | low | medium : how much the model "thinks". minimal is cheapest
AZURE_OPENAI_REASONING_EFFORT=minimal

# Embeddings for the data dictionary: tfidf (default, free) | local (sentence-transformers, free)
EMBEDDING_PROVIDER=tfidf
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hard stop so a bug can't drain your credit (US dollars, per process run)
MAX_SPEND_USD=0.50
